apiVersion: apps/v1
kind: Deployment
metadata:
  name: monitoring-demo
  namespace: monitoring-demo
spec:
  replicas: 2
  selector:
    matchLabels:
      app: monitoring-demo
  template:
    metadata:
      labels:
        app: monitoring-demo
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/path: "/metrics"
        prometheus.io/port: "3000"
    spec:
      containers:
        - name: app
          image: nikhilbarde6161/monitoring-demo:latest
          ports:
            - containerPort: 3000
---
apiVersion: v1
kind: Service
metadata:
  name: monitoring-demo
  namespace: monitoring-demo
spec:
  selector:
    app: monitoring-demo
  ports:
    - port: 80
      targetPort: 3000
  type: ClusterIP
